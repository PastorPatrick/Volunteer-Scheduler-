/**
 * VOLUNTEER SCHEDULER: all-in-one script
 *
 * Paste this whole file into Extensions → Apps Script (replacing Code.gs) and click Save.
 * It is the files in the apps-script folder joined together, generated by
 * tools/build-single-file.js. The sections below are marked with the original file names.
 */

// ##########################################################
// Setup.gs
// ##########################################################

/**
 * ============================================================
 *  SETUP — builds the tabs, the menu, and the hourly timer
 * ============================================================
 *
 * Run "Volunteer Scheduler → Run setup" from the spreadsheet menu.
 * It is safe to run more than once: it adds anything that's missing
 * and never deletes or changes what's already there.
 *
 * Each team on the Teams tab gets two tabs of its own:
 *   "<Team> Team"      one row per volunteer: mobile, Active, and a
 *                      checkbox for each position they're trained in
 *   "<Team> Rotation"  one row per position, one column per week of the
 *                      month (1st–5th Sunday): who usually serves
 * Add a team (or a position) on the Teams tab, then run setup again.
 */

// Tab names. If you rename a tab in the spreadsheet, change it here too.
const TABS = {
  TEAMS: 'Teams',
  SCHEDULE: 'Schedule',
  TEMPLATES: 'Message Templates',
  SETTINGS: 'Settings',
  ACTIVITY: 'Activity Log',
};

const TEAM_TAB_SUFFIX = ' Team';
const ROTATION_TAB_SUFFIX = ' Rotation';
const WEEK_COLUMNS = ['1st Sunday', '2nd Sunday', '3rd Sunday', '4th Sunday', '5th Sunday'];

// Column headers. The script finds columns by these names, so you can drag
// columns into a different order, but don't rename them.
const COLUMNS = {
  TEAMS: ['Team', 'Positions', 'Leader', 'Leader email', 'Active'],
  SCHEDULE: ['Sunday', 'Team', 'Position', 'Serving', 'Status', 'Usual', 'Mobile', 'Asked', 'Answered',
    'Open since', 'Cover texted', 'Can\'t', 'Uncovered notice', 'Notes'],
  TEMPLATES: ['Template', 'When it\'s sent', 'Message'],
  SETTINGS: ['Setting', 'Value', 'What it does'],
  ACTIVITY: ['When', 'Volunteer', 'What happened', 'Details'],
};

const DEFAULT_TEAMS = [
  ['Media', 'ProPresenter, Livestream Producer, Camera Operator, Livestream Audio', '', '', true],
];

// Settings tab rows: [setting name, starting value, explanation].
const DEFAULT_SETTINGS = [
  ['Church name', 'Our Church', 'Used in texts as {ChurchName}.'],
  ['Report email', '', 'Where your emails go: the Monday report and the right-away notices. If blank, they go to the account that owns this sheet.'],
  ['Ask day', '15', 'Day of the month (10am) when everyone in the rotation is texted their Sundays for next month. Leave blank to only send from the menu.'],
  ['Web app link', '', 'Paste the web app link here after publishing it (setup guide, Step 5). Every text links to a page from it.'],
  ['Elvanto service name', 'Sunday Service', 'The Elvanto service the Monday report checks against, so another campus\'s service isn\'t counted. Blank = every service that day.'],
];

// Texts to volunteers. Placeholders: {FirstName} {ChurchName} {Month} {Sundays} {Link}
const DEFAULT_TEMPLATES = [
  ['Monthly ask', 'The ask day (the 15th), to everyone in next month\'s rotation',
    'Hi {FirstName}! Here\'s when you\'re serving at {ChurchName} in {Month}: {Sundays}. Tap to confirm, or let us know which you can\'t make: {Link}'],
  ['Reminder', '3 days later, to anyone who hasn\'t answered',
    'Hi {FirstName}, just a reminder to confirm your {Month} Sundays at {ChurchName}: {Link}'],
  ['Cover request', 'When a spot opens, to everyone trained in that position who is free that Sunday',
    'Hi {FirstName}! Can you cover {Sundays} at {ChurchName}? First to say yes gets it: {Link}'],
  ['Cover confirmed', 'To the person who covers a spot',
    'Thank you, {FirstName}! You\'re serving {Sundays} at {ChurchName}. See you then!'],
];

/** Adds the "Volunteer Scheduler" menu whenever the spreadsheet is opened. */
function onOpen() {
  SpreadsheetApp.getUi()
    .createMenu('Volunteer Scheduler')
    .addItem('Check the rotation', 'checkRotation')
    .addItem('Send next month\'s schedule now', 'sendNextMonthNow')
    .addItem('Send the Monday report now', 'sendReportNow')
    .addSeparator()
    .addItem('Connect Twilio', 'connectTwilio')
    .addItem('Send a test text', 'sendTestText')
    .addItem('Connect Elvanto', 'connectElvanto')
    .addSeparator()
    .addItem('Run setup', 'setup')
    .addToUi();
}

/** Builds everything. Safe to run again at any time. */
function setup() {
  menuOnly_();
  const ss = SpreadsheetApp.getActive();

  const teams = ensureTab_(ss, TABS.TEAMS, COLUMNS.TEAMS);
  if (teams.getLastRow() < 2) DEFAULT_TEAMS.forEach((t) => teams.appendRow(t));
  setupCheckboxColumns_(teams, ['Active']);
  teams_().forEach((team) => setupTeamTabs_(ss, team));

  const schedule = ensureTab_(ss, TABS.SCHEDULE, COLUMNS.SCHEDULE);
  const statusCol = columnIndex_(schedule)['Status'];
  schedule.getRange(2, statusCol, Math.max(schedule.getMaxRows() - 1, 1), 1).setDataValidation(SpreadsheetApp.newDataValidation()
    .requireValueInList([STATUS.WAITING, STATUS.CONFIRMED, STATUS.OPEN], true).setAllowInvalid(true).build());
  addMissingTemplates_(ensureTab_(ss, TABS.TEMPLATES, COLUMNS.TEMPLATES));
  setupSettingsTab_(ensureTab_(ss, TABS.SETTINGS, COLUMNS.SETTINGS));
  ensureTab_(ss, TABS.ACTIVITY, COLUMNS.ACTIVITY);

  // Remove the blank "Sheet1" a new spreadsheet starts with, if it's still empty.
  const blank = ss.getSheetByName('Sheet1');
  if (blank && blank.getLastRow() === 0 && ss.getSheets().length > 1) ss.deleteSheet(blank);

  linkCode_('setup'); // creates the secret used to make private links
  installTrigger_();

  tellUser_(
    'Setup finished.\n\n' +
    'Next:\n' +
    '1. Settings tab: your church name and report email.\n' +
    '2. ' + teams_().map((t) => '"' + t.name + TEAM_TAB_SUFFIX + '"').join(', ') + ': each volunteer, their mobile, Active, and the positions they\'re trained in.\n' +
    '3. ' + teams_().map((t) => '"' + t.name + ROTATION_TAB_SUFFIX + '"').join(', ') + ': who usually serves each position on each Sunday of the month.\n' +
    '4. Publish the web app and connect Twilio (setup guide, Steps 5 and 6).\n\n' +
    'Then use Volunteer Scheduler → Check the rotation.');
}

/** The two tabs for one team: who's trained, and the usual rotation. */
function setupTeamTabs_(ss, team) {
  const people = ensureTab_(ss, team.name + TEAM_TAB_SUFFIX, ['Name', 'Mobile', 'Active'].concat(team.positions).concat(['Notes']));
  setupCheckboxColumns_(people, ['Active'].concat(team.positions));
  const mobileCol = columnIndex_(people)['Mobile'];
  people.getRange(2, mobileCol, Math.max(people.getMaxRows() - 1, 1), 1).setNumberFormat('@'); // keep phone numbers as text

  const rotation = ensureTab_(ss, team.name + ROTATION_TAB_SUFFIX, ['Position'].concat(WEEK_COLUMNS));
  const have = readRows_(rotation).map((r) => String(r['Position']).trim());
  team.positions.filter((p) => have.indexOf(p) === -1).forEach((p) => appendObject_(rotation, { 'Position': p }));
  // Each cell is a name from the team tab (a dropdown).
  rotation.getRange(2, 2, Math.max(rotation.getMaxRows() - 1, 1), WEEK_COLUMNS.length).setDataValidation(SpreadsheetApp.newDataValidation()
    .requireValueInRange(people.getRange(2, 1, Math.max(people.getMaxRows() - 1, 1), 1), true).setAllowInvalid(true).build());
}

/** Shows a message box in the spreadsheet, or writes to the log when run from the script editor. */
function tellUser_(message) {
  try { SpreadsheetApp.getUi().alert(message); } catch (e) { console.log(message); }
}

/** Returns the tab with this name, creating it with bold, frozen headers if needed. */
function ensureTab_(ss, name, headers) {
  let sheet = ss.getSheetByName(name);
  if (!sheet) sheet = ss.insertSheet(name);
  if (sheet.getLastRow() === 0) {
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]).setFontWeight('bold');
    sheet.setFrozenRows(1);
  } else {
    // Add any headers that are missing (a new position, or an update to this script).
    const existing = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0].map((h) => String(h).trim());
    headers.filter((h) => existing.indexOf(h) === -1).forEach((h) => {
      sheet.getRange(1, sheet.getLastColumn() + 1).setValue(h).setFontWeight('bold');
    });
  }
  return sheet;
}

function addMissingTemplates_(sheet) {
  const have = readRows_(sheet).map((t) => String(t['Template']).trim());
  DEFAULT_TEMPLATES.filter((d) => have.indexOf(d[0]) === -1).forEach((d) => appendObject_(sheet, {
    'Template': d[0], 'When it\'s sent': d[1], 'Message': d[2],
  }));
  sheet.setColumnWidth(3, 520);
}

/** Puts checkboxes (validation only, so empty rows stay empty) on the named columns of a tab. */
function setupCheckboxColumns_(sheet, headers) {
  const cols = columnIndex_(sheet);
  const rows = Math.max(sheet.getMaxRows() - 1, 1);
  headers.forEach((h) => { if (cols[h]) sheet.getRange(2, cols[h], rows, 1).setDataValidation(SpreadsheetApp.newDataValidation().requireCheckbox().build()); });
}

function setupSettingsTab_(sheet) {
  const existing = sheet.getLastRow() > 1
    ? sheet.getRange(2, 1, sheet.getLastRow() - 1, 1).getValues().map((r) => r[0])
    : [];
  DEFAULT_SETTINGS.filter((s) => existing.indexOf(s[0]) === -1).forEach((s) => sheet.appendRow(s));
  sheet.setColumnWidth(1, 200);
  sheet.setColumnWidth(2, 260);
  sheet.setColumnWidth(3, 480);
}

/** Makes sure exactly one hourly timer exists. */
function installTrigger_() {
  ScriptApp.getProjectTriggers()
    .filter((t) => t.getHandlerFunction() === 'runScheduledJobs')
    .forEach((t) => ScriptApp.deleteTrigger(t));
  ScriptApp.newTrigger('runScheduledJobs').timeBased().everyHours(1).create();
}


// ##########################################################
// Helpers.gs
// ##########################################################

/**
 * ============================================================
 *  HELPERS — small shared tools used by the other files
 * ============================================================
 * You shouldn't need to change anything in this file.
 */

/**
 * Stops a menu-only function from running anywhere but the spreadsheet menu.
 * Once the web app is published, a visitor could otherwise call these
 * functions from a page.
 */
function menuOnly_() {
  try {
    SpreadsheetApp.getUi();
  } catch (e) {
    throw new Error('Run this from the Volunteer Scheduler menu in the spreadsheet.');
  }
}

/** The current time. (The automated tests set their own clock here.) */
function clockNow_() {
  return new Date();
}

function getTab_(name) {
  const sheet = SpreadsheetApp.getActive().getSheetByName(name);
  if (!sheet) throw new Error('The "' + name + '" tab is missing. Run Volunteer Scheduler → Run setup.');
  return sheet;
}

/** Returns {header name: column number} for a tab's first row. */
function columnIndex_(sheet) {
  const headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
  const map = {};
  headers.forEach((h, i) => { if (h) map[String(h).trim()] = i + 1; });
  return map;
}

/**
 * The last row that really has data, judged by the first column. Google's own
 * getLastRow() also counts empty checkboxes as "data".
 */
function lastDataRow_(sheet) {
  const last = sheet.getLastRow();
  if (last < 1) return 0;
  const firstColumn = sheet.getRange(1, 1, last, 1).getValues();
  for (let i = firstColumn.length - 1; i >= 0; i--) {
    if (String(firstColumn[i][0]).trim() !== '') return i + 1;
  }
  return 0;
}

/** Reads a tab into a list of objects keyed by header name. Each has a _row number. */
function readRows_(sheet) {
  const last = lastDataRow_(sheet);
  if (last < 2) return [];
  const width = sheet.getLastColumn();
  const headers = sheet.getRange(1, 1, 1, width).getValues()[0];
  return sheet.getRange(2, 1, last - 1, width).getValues().map((values, i) => {
    const obj = { _row: i + 2 };
    headers.forEach((h, j) => { if (h) obj[String(h).trim()] = values[j]; });
    return obj;
  });
}

/**
 * Adds a row right after the last real row of a tab, using {header name: value}.
 * Unknown headers are ignored. The first column must be filled in. Returns the row number.
 */
function appendObject_(sheet, obj) {
  const cols = columnIndex_(sheet);
  const width = sheet.getLastColumn();
  const values = new Array(width).fill('');
  Object.keys(obj).forEach((k) => { if (cols[k]) values[cols[k] - 1] = obj[k]; });
  const row = lastDataRow_(sheet) + 1;
  if (row > sheet.getMaxRows()) sheet.insertRowsAfter(sheet.getMaxRows(), 50);
  sheet.getRange(row, 1, 1, width).setValues([values]);
  return row;
}

/** Sets cells in one row by header name. */
function setCells_(sheet, row, values) {
  const cols = columnIndex_(sheet);
  Object.keys(values).forEach((h) => { if (cols[h]) sheet.getRange(row, cols[h]).setValue(values[h]); });
}

// ---------- Settings tab ----------

function getSetting_(name) {
  const sheet = SpreadsheetApp.getActive().getSheetByName(TABS.SETTINGS);
  if (!sheet || sheet.getLastRow() < 2) return '';
  const rows = sheet.getRange(2, 1, sheet.getLastRow() - 1, 2).getValues();
  const hit = rows.find((r) => String(r[0]).trim() === name);
  return hit ? hit[1] : '';
}

/** A setting as it looks on screen (typed numbers and dates come back as typed). */
function getSettingText_(name) {
  const sheet = SpreadsheetApp.getActive().getSheetByName(TABS.SETTINGS);
  if (!sheet || sheet.getLastRow() < 2) return '';
  const rows = sheet.getRange(2, 1, sheet.getLastRow() - 1, 2).getDisplayValues();
  const hit = rows.find((r) => String(r[0]).trim() === name);
  return hit ? String(hit[1]).trim() : '';
}

function setSetting_(name, value) {
  const sheet = getTab_(TABS.SETTINGS);
  const rows = sheet.getRange(2, 1, Math.max(sheet.getLastRow() - 1, 1), 1).getValues();
  const i = rows.findIndex((r) => String(r[0]).trim() === name);
  if (i >= 0) sheet.getRange(i + 2, 2).setValue(value);
  else sheet.appendRow([name, value, '']);
}

/** Where summaries and problems go: the Report email setting, or the sheet owner. */
function reportEmail_() {
  return String(getSetting_('Report email') || '').trim() || Session.getEffectiveUser().getEmail();
}

function churchName_() {
  return getSettingText_('Church name') || 'Our church';
}

// ---------- Templates and the activity log ----------

function getTemplate_(name) {
  const hit = readRows_(getTab_(TABS.TEMPLATES)).find((t) => String(t['Template']).trim() === name);
  return hit ? String(hit['Message']) : '';
}

/**
 * Fills {placeholders} in a text template:
 *   {FirstName}   the volunteer
 *   {ChurchName}  from the Settings tab
 *   {Month}       the month being planned, like "November"
 *   {Sundays}     their spots, like "Camera Operator on Nov 8 and ProPresenter on Nov 22"
 *   {Link}        their own page
 */
function fillTemplate_(text, values) {
  const all = {
    FirstName: values.firstName || 'there',
    ChurchName: churchName_(),
    Month: values.month || 'next month',
    Sundays: values.sundays || '',
    Link: values.link || '',
  };
  return String(text).replace(/\{(\w+)\}/g, (m, key) => (key in all ? all[key] : m));
}

/** Adds a line to the Activity Log tab. */
function logActivity_(volunteer, what, details) {
  appendObject_(getTab_(TABS.ACTIVITY), {
    'When': new Date(), 'Volunteer': volunteer || '', 'What happened': what, 'Details': details || '',
  });
}

// ---------- Private links ----------

/** A short code that proves a link was made by this script for this page. */
function linkCode_(kind, id) {
  const props = PropertiesService.getScriptProperties();
  let secret = props.getProperty('LINK_SECRET');
  if (!secret) {
    secret = Utilities.getUuid() + Utilities.getUuid();
    props.setProperty('LINK_SECRET', secret);
  }
  const signature = Utilities.computeHmacSha256Signature(String(kind) + (id ? '|' + id : ''), secret);
  return Utilities.base64EncodeWebSafe(signature).replace(/=+$/, '').slice(0, 20);
}

// ---------- Formatting ----------

/** Keeps just the last 10 digits, so "(555) 555-0100" and "555.555.0100" match. */
function normalizePhone_(s) {
  return String(s || '').replace(/\D/g, '').slice(-10);
}

function formatPhone_(s) {
  const d = normalizePhone_(s);
  return d.length === 10 ? '(' + d.slice(0, 3) + ') ' + d.slice(3, 6) + '-' + d.slice(6) : String(s || '').trim();
}

function smsNumber_(phone) {
  const d = normalizePhone_(phone);
  return d.length === 10 ? '+1' + d : String(phone).replace(/[^\d+]/g, '');
}

function formatDay_(date) {
  return Utilities.formatDate(date, Session.getScriptTimeZone(), 'EEEE, MMMM d');
}

function ymd_(d) {
  return Utilities.formatDate(d, Session.getScriptTimeZone(), 'yyyy-MM-dd');
}

/** "Nov 8": the short date used in texts. */
function shortDay_(date) {
  return Utilities.formatDate(date, Session.getScriptTimeZone(), 'MMM d');
}

function monthName_(date) {
  return Utilities.formatDate(date, Session.getScriptTimeZone(), 'MMMM');
}

/** "a", "a and b", "a, b and c" */
function joinWords_(list) {
  if (list.length <= 2) return list.join(' and ');
  return list.slice(0, -1).join(', ') + ' and ' + list[list.length - 1];
}

/** Calendar days from d to now (whatever the time of day). */
function daysSince_(d, now) {
  if (!(d instanceof Date)) return 0;
  const day = (x) => new Date(x.getFullYear(), x.getMonth(), x.getDate()).getTime();
  return Math.round((day(now) - day(d)) / 86400000);
}

function escapeHtml_(s) {
  return String(s == null ? '' : s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

// ---------- Emails ----------

function notifyProblem_(text) {
  MailApp.sendEmail({ to: reportEmail_(), subject: 'Volunteer Scheduler: needs your attention', body: text, name: 'Volunteer Scheduler' });
}

/** Sends an email of sections ({title, items: [{text, link}], empty}) as plain text and simple HTML. */
function sendSectionsEmail_(to, subject, greeting, intro, sections) {
  const text = (greeting ? greeting + '\n\n' : '') + intro + '\n\n' + sections.map((s) =>
    (s.title ? s.title.toUpperCase() + '\n' : '') +
    (s.items.length ? s.items.map((i) => '• ' + i.text + (i.link ? ': ' + i.link : '')).join('\n') : (s.empty || ''))).join('\n\n');
  MailApp.sendEmail({
    to: to, subject: subject, name: churchName_() + ' Volunteer Scheduler',
    body: text, htmlBody: sectionsHtml_(greeting ? escapeHtml_(greeting) : '', escapeHtml_(intro), sections),
  });
}

function sectionsHtml_(greeting, intro, sections) {
  return '<div style="font-family:Arial,Helvetica,sans-serif;font-size:15px;color:#16252a;max-width:600px">' +
    (greeting ? '<p style="margin:0 0 8px">' + greeting + '</p>' : '') +
    '<p style="margin:0 0 16px">' + intro + '</p>' +
    sections.map((s) =>
      (s.title ? '<h3 style="font-size:16px;margin:18px 0 6px">' + escapeHtml_(s.title) + '</h3>' : '') +
      (s.items.length
        ? '<ul style="margin:0;padding-left:20px">' + s.items.map((i) => '<li style="margin:0 0 6px">' +
          (i.link ? '<a href="' + escapeHtml_(i.link) + '">' + escapeHtml_(i.text) + '</a>' : escapeHtml_(i.text)) + '</li>').join('') + '</ul>'
        : '<p style="margin:0;color:#5a6b70">' + escapeHtml_(s.empty || '') + '</p>')).join('') +
    '</div>';
}


// ##########################################################
// Teams.gs
// ##########################################################

/**
 * ============================================================
 *  TEAMS — who's trained, and the usual rotation
 * ============================================================
 *
 * Volunteers are told apart by their mobile number, so the same person can
 * be on more than one team. Anyone without a mobile number can't be texted;
 * they're listed in your emails so you can add one.
 */

/** Active teams on the Teams tab, as [{name, positions, leader, leaderEmail}]. */
function teams_() {
  return readRows_(getTab_(TABS.TEAMS))
    .filter((r) => String(r['Team'] || '').trim() && r['Active'] === true)
    .map((r) => ({
      name: String(r['Team']).trim(),
      positions: String(r['Positions'] || '').split(/[,;\n]/).map((p) => p.trim()).filter((p, i, all) => p && all.indexOf(p) === i),
      leader: String(r['Leader'] || '').trim(),
      leaderEmail: String(r['Leader email'] || '').trim(),
    }));
}

function teamByName_(name) {
  return teams_().find((t) => t.name === name) || null;
}

/** A team's volunteers (active or not), as [{name, first, mobile, active, trained: [positions]}]. */
function teamVolunteers_(team) {
  const sheet = SpreadsheetApp.getActive().getSheetByName(team.name + TEAM_TAB_SUFFIX);
  if (!sheet) return [];
  return readRows_(sheet).filter((r) => String(r['Name'] || '').trim()).map((r) => {
    const name = String(r['Name']).trim();
    return {
      name: name, first: name.split(/\s+/)[0], mobile: normalizePhone_(r['Mobile']),
      active: r['Active'] === true, trained: team.positions.filter((p) => r[p] === true),
    };
  });
}

/** One volunteer of a team by name (as typed in the rotation or the Schedule tab). */
function volunteerByName_(team, name) {
  const n = String(name || '').trim().toLowerCase();
  return n ? teamVolunteers_(team).find((v) => v.name.toLowerCase() === n) || null : null;
}

/** Everyone with a mobile number, across all teams: {mobile: {mobile, name, first}}. */
function peopleByMobile_() {
  const out = {};
  teams_().forEach((team) => teamVolunteers_(team).forEach((v) => {
    if (v.mobile.length === 10 && !out[v.mobile]) out[v.mobile] = { mobile: v.mobile, name: v.name, first: v.first };
  }));
  return out;
}

/** The usual rotation: {position: [1st, 2nd, 3rd, 4th, 5th Sunday names]}. */
function rotation_(team) {
  const sheet = SpreadsheetApp.getActive().getSheetByName(team.name + ROTATION_TAB_SUFFIX);
  const out = {};
  if (!sheet) return out;
  readRows_(sheet).forEach((r) => {
    out[String(r['Position']).trim()] = WEEK_COLUMNS.map((w) => String(r[w] || '').trim());
  });
  return out;
}

/** 1 for the 1st Sunday of the month … 5 for the 5th. */
function weekOfMonth_(date) {
  return Math.ceil(date.getDate() / 7);
}

/** Problems with the rotation that would stop a text or break the one-position-a-Sunday rule. */
function rotationProblems_() {
  const problems = [];
  const mobiles = {}; // week → mobile → "Team Position"
  teams_().forEach((team) => {
    const rot = rotation_(team);
    team.positions.forEach((position) => {
      (rot[position] || []).forEach((name, i) => {
        if (!name) return;
        const where = team.name + ', ' + position + ', ' + WEEK_COLUMNS[i];
        const v = volunteerByName_(team, name);
        if (!v) { problems.push(where + ': "' + name + '" isn\'t on the ' + team.name + TEAM_TAB_SUFFIX + ' tab.'); return; }
        if (!v.active) problems.push(where + ': ' + v.name + ' isn\'t marked Active.');
        if (v.mobile.length !== 10) problems.push(where + ': ' + v.name + ' has no mobile number, so they can\'t be texted.');
        if (v.trained.indexOf(position) === -1) problems.push(where + ': ' + v.name + ' isn\'t checked as trained in ' + position + '.');
        const key = v.mobile || v.name.toLowerCase();
        const week = (mobiles[i] = mobiles[i] || {});
        if (week[key]) problems.push(WEEK_COLUMNS[i] + ': ' + v.name + ' is in two positions (' + week[key] + ' and ' + team.name + ' ' + position + '). One person can only fill one position a Sunday.');
        else week[key] = team.name + ' ' + position;
      });
    });
  });
  return problems;
}

/** Menu item: shows anything in the rotation that needs fixing. */
function checkRotation() {
  menuOnly_();
  const ui = SpreadsheetApp.getUi();
  const problems = rotationProblems_();
  const notes = [];
  if (!twilioConfig_()) notes.push('Twilio isn\'t connected yet, so no texts can go out (Volunteer Scheduler → Connect Twilio).');
  if (!String(getSetting_('Web app link') || '').trim()) notes.push('The web app link isn\'t on the Settings tab yet (setup guide, Step 5).');
  const filled = teams_().reduce((n, team) => {
    const rot = rotation_(team);
    return n + team.positions.reduce((m, p) => m + (rot[p] || []).filter((x) => x).length, 0);
  }, 0);
  ui.alert((problems.length ? 'Things to fix:\n\n• ' + problems.join('\n• ') : 'The rotation looks good: ' + filled + ' spot' + (filled === 1 ? '' : 's') + ' filled.') +
    (notes.length ? '\n\nAlso:\n• ' + notes.join('\n• ') : '') +
    '\n\nEmpty spots (like 5th Sundays) are sent out for cover each month.');
}


// ##########################################################
// Schedule.gs
// ##########################################################

/**
 * ============================================================
 *  SCHEDULE — the monthly ask, finding cover, and your emails
 * ============================================================
 *
 * The Schedule tab has one row per Sunday, team and position: who is serving,
 * and whether they've confirmed (Waiting / Confirmed / Open).
 *
 *   Ask day, 10am (the 15th):  next month's rows are made from the rotation.
 *       Each person in it gets ONE text listing their Sundays, with a link to
 *       their own page: "Yes to all", or "Can't" for any Sunday.
 *       Empty spots (like 5th Sundays) open right away.
 *   3 days later:   a reminder text to anyone who hasn't answered.
 *   5 days later:   you get an email listing anyone still silent.
 *   Any "Can't":    you get an email right away (even if they'd confirmed),
 *       and the spot opens.
 *   An open spot:   everyone trained in that position, active, and not
 *       already serving that Sunday is texted. The first to say yes gets it
 *       and is texted a confirmation. (Texts only go out 8am–8pm; a spot that
 *       opens at night goes out in the morning.)
 *   Still open:     you get an email 3 days after a spot opened, after 1 day
 *       if that Sunday is less than a week away, or right away if nobody
 *       else is trained and free.
 *   Mondays, 8am:   the month ahead to you: every Sunday and position, who's
 *       on, what's open, who hasn't answered, and (with Elvanto connected)
 *       who isn't in Elvanto yet.
 *
 * Texts go to volunteers only; everything to you is by email. Elvanto's API
 * can't add people to a service, so you enter the schedule there yourself.
 */

const STATUS = { WAITING: 'Waiting', CONFIRMED: 'Confirmed', OPEN: 'Open' };
const ASK_HOUR = 10;
const REMIND_AFTER_DAYS = 3;
const NO_ANSWER_AFTER_DAYS = 5;
const UNCOVERED_AFTER_DAYS = 3;
const TEXT_HOURS = { from: 8, to: 20 };       // cover requests only go out between 8am and 8pm
const REPORT_TIME = { day: 1, hour: 8 };      // Monday 8am (1 = Monday … 7 = Sunday)
const REPORT_DAYS_AHEAD = 31;

// ---------- Links ----------

function webAppBase_() {
  return String(getSetting_('Web app link') || '').trim();
}

/** A volunteer's own page (the same link every month), by mobile number. */
function personLink_(mobile) {
  const base = webAppBase_();
  return base && mobile ? base + (base.indexOf('?') === -1 ? '?' : '&') + 'p=me&m=' + mobile + '&t=' + linkCode_('person', mobile) : '';
}

// ---------- Reading the Schedule tab ----------

/** Teams and their volunteers, read once for a whole job. */
function scheduleContext_() {
  const ctx = { teams: {}, vols: {} };
  teams_().forEach((t) => { ctx.teams[t.name] = t; ctx.vols[t.name] = teamVolunteers_(t); });
  ctx.byName = (team, name) => {
    const n = String(name || '').trim().toLowerCase();
    return n ? (ctx.vols[team] || []).find((v) => v.name.toLowerCase() === n) || null : null;
  };
  return ctx;
}

/**
 * Every Schedule row, each with _day, _team, _position, _key, _serving,
 * _mobile (of whoever is serving, from their team tab, so a name typed in by
 * hand works too), _cant and _texted (lists of mobiles).
 */
function scheduleRows_(ctx) {
  ctx = ctx || scheduleContext_();
  const list = (x) => String(x || '').split(',').map((s) => normalizePhone_(s)).filter((s) => s.length === 10);
  return readRows_(getTab_(TABS.SCHEDULE)).filter((r) => r['Sunday'] instanceof Date && r['Team'] && r['Position']).map((r) => {
    r._day = ymd_(r['Sunday']);
    r._team = String(r['Team']).trim();
    r._position = String(r['Position']).trim();
    r._key = r._day + '|' + r._team + '|' + r._position;
    r._serving = String(r['Serving'] || '').trim();
    const v = ctx.byName(r._team, r._serving);
    r._mobile = r._serving ? (v && v.mobile) || normalizePhone_(r['Mobile']) : '';
    r._status = String(r['Status'] || '').trim();
    r._cant = list(r['Can\'t']);
    r._texted = list(r['Cover texted']);
    return r;
  });
}

/** True if this person (by mobile) is already serving anywhere that Sunday. */
function busyThatDay_(rows, day, mobile) {
  return rows.some((r) => r._day === day && r._serving && r._mobile === mobile);
}

/** "Camera Operator on Nov 8" */
function spotWords_(r) {
  return r._position + ' on ' + shortDay_(r['Sunday']);
}

/** The Sundays in the month that `date` falls in. */
function sundaysInMonth_(date) {
  const d = new Date(date.getFullYear(), date.getMonth(), 1, 12);
  while (d.getDay() !== 0) d.setDate(d.getDate() + 1);
  const out = [];
  while (d.getMonth() === date.getMonth()) { out.push(new Date(d)); d.setDate(d.getDate() + 7); }
  return out;
}

// ---------- Texting ----------

/** Texts one person a template. Returns '' if sent, or why not. */
function textPerson_(person, templateName, fill) {
  const c = twilioConfig_();
  if (!c) return 'Twilio isn\'t connected';
  if (!person.mobile || person.mobile.length !== 10) return 'no mobile number';
  const text = fillTemplate_(getTemplate_(templateName), Object.assign({ firstName: person.first, link: personLink_(person.mobile) }, fill));
  const problem = sendText_(c, person.mobile, text);
  logActivity_(person.name, problem ? templateName + ' text not sent' : templateName + ' text sent', problem || text);
  return problem;
}

// ---------- The monthly ask ----------

/** Adds next month's rows from the rotation (only ones not already there). Returns notes about the rotation. */
function buildMonth_(month, now) {
  const tab = getTab_(TABS.SCHEDULE);
  const ctx = scheduleContext_();
  const rows = scheduleRows_(ctx);
  const have = rows.map((r) => r._key);
  const serving = {}; // day → [mobile or name]
  rows.forEach((r) => { if (r._serving) (serving[r._day] = serving[r._day] || []).push(r._mobile || r._serving.toLowerCase()); });
  const notes = [];
  sundaysInMonth_(month).forEach((sunday) => {
    const day = ymd_(sunday);
    const week = weekOfMonth_(sunday);
    Object.keys(ctx.teams).forEach((teamName) => {
      const team = ctx.teams[teamName];
      const rot = rotation_(team);
      team.positions.forEach((position) => {
        if (have.indexOf(day + '|' + teamName + '|' + position) !== -1) return;
        const usual = (rot[position] || [])[week - 1] || '';
        let v = ctx.byName(teamName, usual);
        let note = '';
        if (usual && !v) note = '"' + usual + '" isn\'t on the ' + teamName + TEAM_TAB_SUFFIX + ' tab';
        else if (v && !v.active) { note = v.name + ' isn\'t marked Active'; v = null; }
        else if (v && (serving[day] || []).indexOf(v.mobile || v.name.toLowerCase()) !== -1) { note = v.name + ' is already serving another position that Sunday'; v = null; }
        if (v) (serving[day] = serving[day] || []).push(v.mobile || v.name.toLowerCase());
        if (note) notes.push(position + ', ' + formatDay_(sunday) + ': ' + note + ', so the spot is open.');
        appendObject_(tab, {
          'Sunday': sunday, 'Team': teamName, 'Position': position, 'Serving': v ? v.name : '',
          'Status': v ? STATUS.WAITING : STATUS.OPEN, 'Usual': usual, 'Mobile': v ? formatPhone_(v.mobile) : '',
          'Open since': v ? '' : now, 'Notes': note,
        });
      });
    });
  });
  return notes;
}

/**
 * Makes next month's rows and texts each person in the rotation their
 * Sundays (only people not already asked), then sends open spots out for
 * cover. Safe to run again. Returns what happened, and emails it to you.
 */
function askMonth_(month, now) {
  if (!webAppBase_()) throw new Error('Publish the web app first (setup guide, Step 5) and paste its link on the Settings tab.');
  if (!twilioConfig_()) throw new Error('Connect Twilio first (Volunteer Scheduler → Connect Twilio). Volunteers are reached by text.');
  const monthKey = ymd_(month).slice(0, 7);
  const name = monthName_(month);
  const notes = buildMonth_(month, now);
  const tab = getTab_(TABS.SCHEDULE);
  const ctx = scheduleContext_();
  const toAsk = scheduleRows_(ctx).filter((r) => r._day.slice(0, 7) === monthKey && r._status === STATUS.WAITING && r._serving && !r['Asked']);
  const byPerson = {};
  toAsk.forEach((r) => { const k = r._mobile || 'name:' + r._serving; (byPerson[k] = byPerson[k] || []).push(r); });
  const asked = [], notReached = [];
  Object.keys(byPerson).forEach((k) => {
    const rows = byPerson[k];
    const person = { name: rows[0]._serving, first: rows[0]._serving.split(/\s+/)[0], mobile: rows[0]._mobile };
    const problem = textPerson_(person, 'Monthly ask', { month: name, sundays: joinWords_(rows.map(spotWords_)) });
    if (problem) { notReached.push(person.name + ' (' + problem + ')'); return; }
    rows.forEach((r) => setCells_(tab, r._row, { 'Asked': now }));
    asked.push(person.name);
  });

  // Remember the ask, for the reminder and the no-answer email. Asking again
  // about the same month (for someone just added) keeps the original dates.
  const props = PropertiesService.getScriptProperties();
  let state = null;
  try { state = JSON.parse(props.getProperty('MONTH_ASK') || 'null'); } catch (e) { state = null; }
  if (!state || state.month !== monthKey) {
    props.setProperty('MONTH_ASK', JSON.stringify({ month: monthKey, asked: now.getTime(), reminded: false, noAnswer: false }));
  }

  const covers = sendCoverRequests_(now, true);
  const open = scheduleRows_().filter((r) => r._day.slice(0, 7) === monthKey && r._status === STATUS.OPEN && !r._serving);
  if (asked.length || notReached.length || open.length) {
    sendSectionsEmail_(reportEmail_(), name + ' schedule sent', '',
      asked.length + ' volunteer' + (asked.length === 1 ? ' was' : 's were') + ' texted their ' + name + ' Sundays. You\'ll get an email when anyone says they can\'t.', [
        { title: 'Texted', items: asked.length ? [{ text: asked.join(', ') }] : [], empty: 'Nobody new.' },
        { title: 'Couldn\'t text', items: notReached.map((t) => ({ text: t })) },
        { title: 'Open spots sent out for cover', items: open.map((r) => ({ text: spotWords_(r) + ': ' +
          (covers[r._key] && covers[r._key].length ? 'asked ' + joinWords_(covers[r._key]) : 'nobody else is trained and free that day') })) },
        { title: 'From the rotation', items: notes.map((t) => ({ text: t })) },
      ].filter((s) => s.items.length || s.empty));
  }
  logActivity_('', name + ' schedule sent', asked.length + ' texted' + (notReached.length ? '; not reached: ' + notReached.join(', ') : ''));
  return { asked: asked, notReached: notReached, open: open.length, month: name };
}

// ---------- Finding cover ----------

/** Who could cover an open spot: active, trained, with a mobile, free that Sunday, and didn't say they can't. */
function coverCandidates_(r, rows, ctx) {
  return (ctx.vols[r._team] || []).filter((v) => v.active && v.mobile.length === 10 && v.trained.indexOf(r._position) !== -1 &&
    r._cant.indexOf(v.mobile) === -1 && !busyThatDay_(rows, r._day, v.mobile));
}

/**
 * Texts everyone who could cover an open spot and hasn't been asked about it
 * yet; one text per person, listing all their spots. Only 8am–8pm unless
 * `anyTime`. Returns {spot key: [first names texted]}.
 */
function sendCoverRequests_(now, anyTime) {
  const hour = Number(Utilities.formatDate(now, Session.getScriptTimeZone(), 'H'));
  if (!anyTime && (hour < TEXT_HOURS.from || hour >= TEXT_HOURS.to)) return {};
  if (!twilioConfig_() || !webAppBase_()) return {};
  const ctx = scheduleContext_();
  const rows = scheduleRows_(ctx);
  const today = ymd_(now);
  const perPerson = {};
  rows.filter((r) => r._status === STATUS.OPEN && !r._serving && r._day > today).forEach((r) => {
    coverCandidates_(r, rows, ctx).filter((v) => r._texted.indexOf(v.mobile) === -1).forEach((v) => {
      (perPerson[v.mobile] = perPerson[v.mobile] || { v: v, rows: [] }).rows.push(r);
    });
  });
  const tab = getTab_(TABS.SCHEDULE);
  const texted = {};
  Object.keys(perPerson).forEach((mobile) => {
    const p = perPerson[mobile];
    if (textPerson_(p.v, 'Cover request', { sundays: joinWords_(p.rows.map(spotWords_)) })) return;
    p.rows.forEach((r) => {
      r._texted.push(mobile);
      (texted[r._key] = texted[r._key] || []).push(p.v.first);
      setCells_(tab, r._row, { 'Cover texted': r._texted.map(formatPhone_).join(', ') });
    });
  });
  return texted;
}

/** Emails you about open spots nobody has taken (once per spot each time it opens). */
function checkUncovered_(now) {
  const ctx = scheduleContext_();
  const rows = scheduleRows_(ctx);
  const today = ymd_(now);
  const due = rows.filter((r) => {
    if (r._status !== STATUS.OPEN || r._serving || r._day <= today || r['Uncovered notice']) return false;
    const since = r['Open since'] instanceof Date ? r['Open since'] : now;
    const hours = (now.getTime() - since.getTime()) / 3600000;
    const daysAway = -daysSince_(r['Sunday'], now);
    return !coverCandidates_(r, rows, ctx).length || daysSince_(since, now) >= UNCOVERED_AFTER_DAYS || (daysAway < 7 && hours >= 24);
  });
  if (!due.length) return 0;
  const names = (r) => r._texted.map((m) => { const v = (ctx.vols[r._team] || []).find((x) => x.mobile === m); return v ? v.name : formatPhone_(m); });
  sendSectionsEmail_(recipientsFor_(due.map((r) => r._team)), 'Still open: ' + due.map(spotWords_).join(', '), '',
    'Nobody has said yes to ' + (due.length === 1 ? 'this spot' : 'these spots') + ' yet. You may need to find someone yourself.', [
      { title: '', items: due.map((r) => ({ text: r._team + ' ' + spotWords_(r) + ': ' +
        (r._texted.length ? 'asked ' + joinWords_(names(r)) + ', no yes yet' : 'nobody else is trained, active, and free that Sunday') })) },
    ]);
  const tab = getTab_(TABS.SCHEDULE);
  due.forEach((r) => setCells_(tab, r._row, { 'Uncovered notice': now }));
  return due.length;
}

/** The report email, plus the leaders of these teams (if they have an email on the Teams tab). */
function recipientsFor_(teamNames) {
  const out = [reportEmail_()];
  teamNames.forEach((n) => { const t = teamByName_(n); if (t && t.leaderEmail && out.indexOf(t.leaderEmail) === -1) out.push(t.leaderEmail); });
  return out.join(',');
}

// ---------- Reminder and no-answer ----------

/** 3 days after the ask: a reminder text to everyone still Waiting for that month. */
function remindNoAnswer_(state) {
  const rows = scheduleRows_().filter((r) => r._day.slice(0, 7) === state.month && r._status === STATUS.WAITING && r._serving && r['Asked']);
  const month = monthName_(rows.length ? rows[0]['Sunday'] : new Date());
  const done = {};
  rows.forEach((r) => {
    if (!r._mobile || done[r._mobile]) return;
    done[r._mobile] = true;
    textPerson_({ name: r._serving, first: r._serving.split(/\s+/)[0], mobile: r._mobile }, 'Reminder', { month: month });
  });
  return Object.keys(done).length;
}

/** 5 days after the ask: everyone who still hasn't answered, to you. */
function emailNoAnswer_(state) {
  const rows = scheduleRows_().filter((r) => r._day.slice(0, 7) === state.month && r._status === STATUS.WAITING && r._serving);
  if (!rows.length) return 0;
  const byPerson = {};
  rows.forEach((r) => { (byPerson[r._serving] = byPerson[r._serving] || []).push(r); });
  const month = monthName_(rows[0]['Sunday']);
  sendSectionsEmail_(recipientsFor_(rows.map((r) => r._team)), 'No answer yet: ' + Object.keys(byPerson).join(', '), '',
    'These volunteers haven\'t confirmed their ' + month + ' Sundays, even after a reminder. They\'re still on the schedule; you may want to check with them.', [
      { title: '', items: Object.keys(byPerson).map((n) => ({ text: n + (byPerson[n][0]._mobile ? ', ' + formatPhone_(byPerson[n][0]._mobile) : ', no mobile number') +
        ': ' + joinWords_(byPerson[n].map(spotWords_)) })) },
    ]);
  return Object.keys(byPerson).length;
}

// ---------- The Monday report ----------

/** The month ahead, to you. Returns false when there's nothing scheduled. */
function sendReport_(now) {
  const today = ymd_(now);
  const until = ymd_(new Date(now.getFullYear(), now.getMonth(), now.getDate() + REPORT_DAYS_AHEAD, 12));
  const rows = scheduleRows_().filter((r) => r._day >= today && r._day <= until)
    .sort((a, b) => (a._day < b._day ? -1 : a._day > b._day ? 1 : a._row - b._row));
  if (!rows.length) return false;
  const teamCount = rows.map((r) => r._team).filter((t, i, all) => all.indexOf(t) === i).length;
  const label = (r) => (teamCount > 1 ? r._team + ' · ' : '') + r._position;

  // Elvanto: who's on the schedule there, to flag anyone not entered yet.
  let roster = null, elvantoNote = '';
  if (elvantoConnected_()) {
    try {
      const first = rows[0]['Sunday'], last = rows[rows.length - 1]['Sunday'];
      roster = elvantoRoster_(new Date(first.getFullYear(), first.getMonth(), first.getDate() - 1, 12), new Date(last.getFullYear(), last.getMonth(), last.getDate() + 1, 12));
    } catch (e) { elvantoNote = 'Couldn\'t check Elvanto: ' + e.message; }
  }
  const norm = (s) => String(s || '').toLowerCase().replace(/[^a-z]/g, '');
  const inElvanto = (r) => roster.some((e) => e.day === r._day && !e.declined &&
    [e.first + e.last, e.legalFirst + e.last].map(norm).indexOf(norm(r._serving)) !== -1);

  const open = rows.filter((r) => !r._serving);
  const waiting = rows.filter((r) => r._serving && r._status === STATUS.WAITING);
  const missing = roster ? rows.filter((r) => r._serving && !inElvanto(r)) : [];
  const attention = []
    .concat(open.map((r) => ({ text: 'Open: ' + label(r) + ', ' + formatDay_(r['Sunday']) + (r._texted.length ? ' (' + r._texted.length + ' asked, no yes yet)' : '') })))
    .concat(waiting.map((r) => ({ text: 'No answer: ' + r._serving + (r._mobile ? ' ' + formatPhone_(r._mobile) : '') + ', ' + label(r) + ', ' + formatDay_(r['Sunday']) })))
    .concat(missing.map((r) => ({ text: 'Not in Elvanto yet: ' + r._serving + ', ' + label(r) + ', ' + formatDay_(r['Sunday']) })))
    .concat(elvantoNote ? [{ text: elvantoNote }] : []);

  const days = rows.map((r) => r._day).filter((d, i, all) => all.indexOf(d) === i);
  const sections = [{ title: 'Needs attention', items: attention, empty: 'Nothing. Every spot is filled and confirmed' + (roster ? ' and in Elvanto.' : '.') }]
    .concat(days.map((day) => {
      const onDay = rows.filter((r) => r._day === day);
      return { title: formatDay_(onDay[0]['Sunday']), items: onDay.map((r) => ({
        text: label(r) + ': ' + (!r._serving ? 'OPEN' : r._serving + (r._status === STATUS.WAITING ? ' (hasn\'t confirmed)' : '') +
          (roster ? (inElvanto(r) ? ' ✓ in Elvanto' : ' (not in Elvanto yet)') : '')),
      })) };
    }));
  sendSectionsEmail_(reportEmail_(), 'Serving schedule: the month ahead' + (open.length ? ' (' + open.length + ' open)' : ''), '',
    'Here\'s every Sunday for the next month.', sections);
  logActivity_('', 'Monday report sent', '');
  return true;
}

// ---------- The hourly timer ----------

function runScheduledJobs() {
  runScheduledJobs_(clockNow_());
}

function runScheduledJobs_(now) {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(30000)) return;
  try {
    const tz = Session.getScriptTimeZone();
    const hour = Number(Utilities.formatDate(now, tz, 'H'));
    const weekday = Number(Utilities.formatDate(now, tz, 'u'));
    const props = PropertiesService.getScriptProperties();
    let state = null;
    try { state = JSON.parse(props.getProperty('MONTH_ASK') || 'null'); } catch (e) { state = null; }
    const save = () => props.setProperty('MONTH_ASK', JSON.stringify(state));

    // The monthly ask: on the ask day (or later, if it was missed), about next month.
    const askDay = Math.min(Number(getSettingText_('Ask day')) || 0, 28);
    const next = new Date(now.getFullYear(), now.getMonth() + 1, 1, 12);
    if (askDay && now.getDate() >= askDay && hour >= ASK_HOUR && (!state || state.month < ymd_(next).slice(0, 7))) {
      try { askMonth_(next, now); } catch (e) { reportProblemOnce_('monthly text', now, e); }
    } else if (state && hour >= ASK_HOUR) {
      const since = daysSince_(new Date(state.asked), now);
      if (!state.reminded && since >= REMIND_AFTER_DAYS) {
        state.reminded = true; save();
        try { remindNoAnswer_(state); } catch (e) { reportProblemOnce_('reminder', now, e); }
      }
      if (!state.noAnswer && since >= NO_ANSWER_AFTER_DAYS) {
        state.noAnswer = true; save();
        try { emailNoAnswer_(state); } catch (e) { reportProblemOnce_('no-answer email', now, e); }
      }
    }

    try { sendCoverRequests_(now, false); } catch (e) { reportProblemOnce_('cover request', now, e); }
    try { checkUncovered_(now); } catch (e) { reportProblemOnce_('open-spot check', now, e); }

    if (weekday === REPORT_TIME.day && hour >= REPORT_TIME.hour && props.getProperty('LAST_REPORT') !== ymd_(now)) {
      props.setProperty('LAST_REPORT', ymd_(now));
      try { sendReport_(now); } catch (e) { reportProblemOnce_('Monday report', now, e); }
    }
  } finally {
    lock.releaseLock();
  }
}

/** Emails a problem to you, at most once a day for each job. */
function reportProblemOnce_(job, now, e) {
  const props = PropertiesService.getScriptProperties();
  if (props.getProperty('PROBLEM_' + job) === ymd_(now)) return;
  props.setProperty('PROBLEM_' + job, ymd_(now));
  try { notifyProblem_('The Volunteer Scheduler\'s ' + job + ' didn\'t finish: ' + e.message); } catch (e2) { /* nothing more to do */ }
}

// ---------- Menu items ----------

/** Menu item: makes next month's schedule and texts it now (only people not already asked). */
function sendNextMonthNow() {
  menuOnly_();
  const ui = SpreadsheetApp.getUi();
  const now = clockNow_();
  let result;
  try {
    result = askMonth_(new Date(now.getFullYear(), now.getMonth() + 1, 1, 12), now);
  } catch (e) {
    ui.alert(e.message);
    return;
  }
  ui.alert((result.asked.length ? 'Texted ' + result.asked.length + ' volunteer' + (result.asked.length === 1 ? '' : 's') + ' their ' + result.month + ' Sundays.'
    : 'Everyone in the ' + result.month + ' rotation has already been texted.') +
    (result.notReached.length ? '\n\nCouldn\'t text: ' + result.notReached.join(', ') : '') +
    (result.open ? '\n\n' + result.open + ' open spot' + (result.open === 1 ? '' : 's') + ' sent out for cover.' : '') +
    '\n\nThe details are in your email.');
}

/** Menu item: sends the Monday report now. */
function sendReportNow() {
  menuOnly_();
  const sent = sendReport_(clockNow_());
  SpreadsheetApp.getUi().alert(sent ? 'Sent to ' + reportEmail_() + '.' : 'Nothing is scheduled for the next month yet.');
}


// ##########################################################
// Pages.gs
// ##########################################################

/**
 * ============================================================
 *  PAGES — each volunteer's own page
 * ============================================================
 *
 * Every text links to the volunteer's own page (one link per mobile number,
 * the same every month). It shows:
 *   Your Sundays:    each spot they're on, with "I'll be there" and "Can't"
 *                    (and "Yes to all" when several are waiting).
 *   Can you cover?   open spots in positions they're trained in, on Sundays
 *                    they're free, with "I can cover". First yes gets it.
 *
 * The page only works after the script is published as a web app (setup
 * guide, Step 5). Each link carries a security code made from a secret kept
 * in this script, so nobody can guess another volunteer's link.
 *
 * Opening a link never changes anything. Only tapping a button does. (Phones
 * load links to show previews, and that must not record an answer by accident.)
 */

/** Runs when someone opens their link. Never changes anything. */
function doGet(e) {
  const p = (e && e.parameter) || {};
  const mobile = normalizePhone_(p.m);
  const person = p.p === 'me' && mobile.length === 10 && String(p.t || '') === linkCode_('person', mobile) ? peopleByMobile_()[mobile] : null;
  return HtmlService.createHtmlOutput(pageShell_(person ? renderPersonPage_(person) : renderNotFound_(), person ? 'me:' + mobile : '', person ? String(p.t) : ''))
    .setTitle(churchName_() + ' – Serving')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

/**
 * Called by the page's buttons. Returns {html, message} so the page can redraw.
 * action: yesall | yes | cant | cover
 */
function pageAction(page, code, action, row, key) {
  const mobile = String(page || '').indexOf('me:') === 0 ? String(page).slice(3) : '';
  const person = mobile && String(code || '') === linkCode_('person', mobile) ? peopleByMobile_()[mobile] : null;
  if (!person) return { html: renderNotFound_(), message: '' };
  if (['yesall', 'yes', 'cant', 'cover'].indexOf(action) === -1) return { html: renderPersonPage_(person), message: 'That button isn\'t available here.' };
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(20000)) return { html: '', message: 'Busy right now. Please try again in a moment.' };
  let message;
  try {
    message = applyAction_(person, action, Number(row), String(key || ''), clockNow_());
  } catch (e) {
    message = 'Something went wrong: ' + e.message + '. Please try again.';
  } finally {
    lock.releaseLock();
  }
  return { html: renderPersonPage_(person), message: message };
}

function applyAction_(person, action, row, key, now) {
  const tab = getTab_(TABS.SCHEDULE);
  const ctx = scheduleContext_();
  const rows = scheduleRows_(ctx);
  const today = ymd_(now);
  const mine = (r) => r._serving && r._mobile === person.mobile;

  if (action === 'yesall') {
    const waiting = rows.filter((r) => mine(r) && r._status === STATUS.WAITING && r._day >= today);
    if (!waiting.length) return 'You\'re all set. Thank you!';
    waiting.forEach((r) => setCells_(tab, r._row, { 'Status': STATUS.CONFIRMED, 'Answered': now }));
    logActivity_(person.name, 'Confirmed', joinWords_(waiting.map(spotWords_)));
    return 'Thank you! You\'re confirmed for ' + joinWords_(waiting.map(spotWords_)) + '.';
  }

  const r = rows.find((x) => x._row === row && x._key === key);
  if (!r) return 'The schedule changed while you were looking. Please try again.';
  if (r._day < today) return 'That Sunday has already passed.';

  if (action === 'yes') {
    if (!mine(r)) return 'You\'re not on ' + spotWords_(r) + ' anymore.';
    if (r._status !== STATUS.CONFIRMED) setCells_(tab, r._row, { 'Status': STATUS.CONFIRMED, 'Answered': now });
    logActivity_(person.name, 'Confirmed', spotWords_(r));
    return 'Thank you! You\'re confirmed for ' + spotWords_(r) + '.';
  }

  if (action === 'cant') {
    if (!mine(r)) return 'You\'re not on ' + spotWords_(r) + '.';
    const wasConfirmed = r._status === STATUS.CONFIRMED;
    setCells_(tab, r._row, {
      'Serving': '', 'Mobile': '', 'Status': STATUS.OPEN, 'Answered': now, 'Open since': now, 'Uncovered notice': '',
      'Cover texted': '', 'Can\'t': r._cant.concat([person.mobile]).map(formatPhone_).join(', '),
      'Notes': [String(r['Notes'] || ''), person.name + ' can\'t (' + shortDay_(now) + ')'].filter((x) => x).join('; '),
    });
    logActivity_(person.name, 'Can\'t serve', spotWords_(r));
    const asked = sendCoverRequests_(now, false)[r._key] || [];
    tellCoordinatorCant_(person, r, wasConfirmed, asked, now);
    return 'Thanks for letting us know. We\'ll find someone to cover ' + spotWords_(r) + '.';
  }

  // cover
  if (mine(r)) return 'You\'re already on ' + spotWords_(r) + '. Thank you!';
  if (r._serving || r._status !== STATUS.OPEN) return 'Thank you! ' + (r._serving ? r._serving.split(/\s+/)[0] + ' already said yes' : 'It\'s already covered') + ', so you\'re not needed for this one.';
  const v = (ctx.vols[r._team] || []).find((x) => x.mobile === person.mobile);
  if (!v || !v.active || v.trained.indexOf(r._position) === -1) return 'You\'re not set up for ' + r._position + '. Please check with your team leader.';
  const other = rows.find((x) => x._day === r._day && mine(x));
  if (other) return 'You\'re already serving ' + other._position + ' that Sunday, and it\'s one position a Sunday.';
  setCells_(tab, r._row, {
    'Serving': v.name, 'Mobile': formatPhone_(v.mobile), 'Status': STATUS.CONFIRMED, 'Answered': now,
    'Notes': [String(r['Notes'] || ''), 'Covered by ' + v.name + ' (' + shortDay_(now) + ')'].filter((x) => x).join('; '),
  });
  logActivity_(v.name, 'Covered', spotWords_(r));
  textPerson_(v, 'Cover confirmed', { sundays: spotWords_(r) });
  if (r._cant.length || r['Uncovered notice']) tellCoordinatorCovered_(v, r);
  return 'Thank you! ' + spotWords_(r) + ' is yours. We\'ve texted you a confirmation.';
}

/** Right away, to you (and the team leader): someone can't serve. */
function tellCoordinatorCant_(person, r, wasConfirmed, asked, now) {
  const hour = Number(Utilities.formatDate(now, Session.getScriptTimeZone(), 'H'));
  const rows = scheduleRows_();
  const fresh = rows.find((x) => x._key === r._key) || r;
  const nobody = !coverCandidates_(fresh, rows, scheduleContext_()).length;
  const cover = asked.length ? 'A cover request was texted to ' + joinWords_(asked) + '. The first to say yes gets it; you\'ll hear if nobody does.'
    : nobody ? 'Nobody else on ' + r._team + ' is trained in ' + r._position + ', active, and free that Sunday, so you\'ll need to find someone.'
      : hour < TEXT_HOURS.from || hour >= TEXT_HOURS.to ? 'The cover request will be texted at ' + TEXT_HOURS.from + 'am.' : 'A cover request will go out shortly.';
  const subject = person.name + ' can\'t serve ' + r._position + ' on ' + formatDay_(r['Sunday']);
  const body = person.name + (wasConfirmed ? ' had confirmed, but' : '') + ' just said they can\'t serve ' + r._position + ' (' + r._team + ') on ' +
    formatDay_(r['Sunday']) + '.\n\n' + cover + (wasConfirmed ? '\n\nIf they were already in Elvanto, take them off there.' : '');
  MailApp.sendEmail({ to: recipientsFor_([r._team]), subject: subject, name: churchName_() + ' Volunteer Scheduler', body: body,
    htmlBody: sectionsHtml_('', escapeHtml_(body).replace(/\n/g, '<br>'), []) });
}

/** To you: a spot someone couldn't make has been covered. */
function tellCoordinatorCovered_(v, r) {
  const body = v.name + ' will cover ' + r._position + ' (' + r._team + ') on ' + formatDay_(r['Sunday']) + '. Add them in Elvanto.';
  MailApp.sendEmail({ to: recipientsFor_([r._team]), subject: 'Covered: ' + r._position + ' on ' + formatDay_(r['Sunday']) + ' (' + v.name + ')',
    name: churchName_() + ' Volunteer Scheduler', body: body, htmlBody: sectionsHtml_('', escapeHtml_(body), []) });
}

function renderPersonPage_(person) {
  const now = clockNow_();
  const today = ymd_(now);
  const ctx = scheduleContext_();
  const rows = scheduleRows_(ctx).filter((r) => r._day >= today)
    .sort((a, b) => (a._day < b._day ? -1 : a._day > b._day ? 1 : a._row - b._row));
  const mine = rows.filter((r) => r._serving && r._mobile === person.mobile);
  const cover = rows.filter((r) => r._status === STATUS.OPEN && !r._serving && r._day > today &&
    coverCandidates_(r, rows, ctx).some((v) => v.mobile === person.mobile));
  const attrs = (r) => ' data-row="' + r._row + '" data-key="' + escapeHtml_(r._key) + '"';
  const waiting = mine.filter((r) => r._status === STATUS.WAITING);
  let html = '<header><p class="eyebrow">' + escapeHtml_(churchName_()) + ' · Serving</p><h1>Hi ' + escapeHtml_(person.first) + '!</h1></header>';

  html += '<h2>Your Sundays</h2>';
  if (!mine.length) html += '<section class="card"><p class="hint">You\'re not on the schedule right now.</p></section>';
  if (waiting.length > 1) html += '<section class="card"><button class="primary big" data-action="yesall">Yes to all ' + waiting.length + '</button></section>';
  mine.forEach((r) => {
    const confirmed = r._status === STATUS.CONFIRMED;
    html += '<section class="card' + (confirmed ? ' is-done' : '') + '"><p><b>' + escapeHtml_(formatDay_(r['Sunday'])) + '</b><br>' +
      escapeHtml_(r._position) + (confirmed ? ' <span class="done">✓ Confirmed</span>' : '') + '</p>' +
      (confirmed ? '' : '<button class="primary" data-action="yes"' + attrs(r) + '>I\'ll be there</button> ') +
      '<button data-action="cant"' + attrs(r) + '>' + (confirmed ? 'I can\'t make it after all' : 'Can\'t') + '</button></section>';
  });

  if (cover.length) {
    html += '<h2>Can you cover?</h2><p class="hint">The first person to say yes gets it.</p>';
    cover.forEach((r) => {
      html += '<section class="card"><p><b>' + escapeHtml_(formatDay_(r['Sunday'])) + '</b><br>' + escapeHtml_(r._position) + '</p>' +
        '<button class="primary" data-action="cover"' + attrs(r) + '>I can cover</button></section>';
    });
  }
  return html;
}

function renderNotFound_() {
  return '<section class="card"><h1>This link doesn\'t work</h1>' +
    '<p>It may have been copied incompletely. Ask your volunteer coordinator for a fresh link.</p></section>';
}

/** The page around the content: styles and the small script that runs the buttons. */
function pageShell_(body, page, code) {
  return '<!doctype html><html><head><meta charset="utf-8">' +
    '<style>' +
    ':root{--bg:#f3f6f5;--card:#fff;--ink:#16252a;--muted:#5a6b70;--line:#d7e0df;--accent:#1f5e73;--good:#2b7148;--warn:#fff4cc}' +
    '@media (prefers-color-scheme:dark){:root{--bg:#0e1618;--card:#152125;--ink:#e3ecec;--muted:#98aaae;--line:#26373b;--accent:#72b6cc;--good:#6dc18d;--warn:#372b14}}' +
    '*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 -apple-system,Segoe UI,Roboto,Arial,sans-serif}' +
    'main{max-width:720px;margin:0 auto;padding:16px}h1{font-size:28px;margin:0 0 4px}h2{font-size:19px;margin:16px 0 6px}' +
    '.eyebrow{margin:0;font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}.facts{margin:0 0 16px;color:var(--muted)}' +
    '.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px 16px;margin:0 0 10px}.card p{margin:0 0 8px}.card h2{margin-top:0}' +
    '.hint{color:var(--muted);font-size:15px}.warn{background:var(--warn);padding:2px 8px;border-radius:8px}' +
    'button{font:inherit;font-weight:600;padding:12px 18px;border-radius:10px;border:1px solid var(--line);background:var(--card);color:var(--ink);cursor:pointer;margin-top:6px}' +
    '.primary{background:var(--accent);border-color:var(--accent);color:#fff}.big{width:100%}.done{color:var(--good);font-weight:700;font-size:16px}' +
    '.is-done{opacity:.85}a{color:var(--accent)}' +
    '#msg{position:sticky;top:0;z-index:2;background:var(--accent);color:#fff;padding:10px 14px;border-radius:10px;margin:0 0 12px}' +
    'button:disabled{opacity:.5}:focus-visible{outline:2px solid var(--accent);outline-offset:2px}' +
    '</style></head><body><main><div id="msg" hidden></div><div id="app">' + body + '</div></main>' +
    '<script>' + PAGE_CLIENT_JS.replace('__PAGE__', JSON.stringify(page)).replace('__CODE__', JSON.stringify(code)) + '</script></body></html>';
}

// The pages' own script: press a button, save, and redraw.
const PAGE_CLIENT_JS = [
  'var PAGE=__PAGE__,CODE=__CODE__;',
  'function show(m){var el=document.getElementById("msg");if(!m){el.hidden=true;return;}el.textContent=m;el.hidden=false;window.scrollTo(0,0);}',
  'document.addEventListener("click",function(ev){var b=ev.target.closest("button");if(!b||!b.dataset.action)return;',
  ' b.disabled=true;show("Saving…");',
  ' google.script.run.withSuccessHandler(function(r){if(r.html)document.getElementById("app").innerHTML=r.html;show(r.message);})',
  ' .withFailureHandler(function(e){b.disabled=false;show("Couldn\'t save: "+e.message+". Please try again.");})',
  ' .pageAction(PAGE,CODE,b.dataset.action,b.dataset.row||0,b.dataset.key||"");',
  '});',
].join('\n');


